# Copier en .env, puis personnaliser
PUBLIC_URL=https://todo.example.com
PUBLIC_HOST=todo.example.com
# Port INTERNE du conteneur (Traefik lira ce même port)
APP_PORT=
# Nom EXACT de votre réseau Docker Traefik existant
TRAEFIK_NETWORK=
# Cert resolver Traefik existant : souvent letsencrypt, le, cloudflare...
TRAEFIK_CERTRESOLVER=
# À remplacer par l'URL publique exacte de Pocket ID, sans / final
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=REMPLACER
OIDC_CLIENT_SECRET=REMPLACER
RUST_LOG=todo=info
